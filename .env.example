# =====================================================================
# Repo root — docker-compose interpolation only
# =====================================================================
# Copy to .env at the repo root. Compose reads THIS file to resolve the
# ${VAR} placeholders in docker-compose.yml, before any container is
# created.
#
# This is not the same thing as the per-app env files. Those are listed
# under `env_file:` and set variables INSIDE a running container:
#
#   apps/server/.env   ->  mcp-server container environment
#   apps/web/.env      ->  web container environment
#
# A host port mapping is resolved by compose itself, so it can only come
# from here. Putting WEB_PORT in apps/web/.env has no effect at all.
# =====================================================================

# --- Host port bindings ----------------------------------------------
# Left-hand side of the published port mappings. Change these when the
# host already has something on the default port; do not edit
# docker-compose.yml, which turns into a permanent local modification
# that conflicts on every pull.

# Host port for the web dashboard. Container always listens on 3001.
WEB_PORT=3001

# Host port for the API, and the port the server binds to inside its
# container. Dual-purpose, so it must ALSO be set in apps/server/.env —
# compose reads this file for the mapping, the server reads that one to
# know what to listen on. Keep the two in sync.
MCP_SERVER_PORT=3100

# --- Web build arg ---------------------------------------------------
# Baked into the web image at BUILD time, not read at runtime, because
# NEXT_PUBLIC_* values are inlined into the client bundle. Building
# without it silently produces a dashboard pointing at localhost.
#
#   NEXT_PUBLIC_LORE_API_URL=https://lore.example.com docker compose build web
#
# Set it here so a plain `docker compose build web` picks it up.
NEXT_PUBLIC_LORE_API_URL=http://localhost:3100
